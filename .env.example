# API Gateway (Python/FastAPI)
APP_NAME=Pulse API Gateway
APP_VERSION=1.0.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
HEALTH_CHECKER_URL=http://health-checker:8001
ALERT_SERVICE_URL=http://alert-service:8002

# Health Checker (Go)
CHECKER_PORT=8001
CHECK_TIMEOUT=5s
API_GATEWAY_URL=http://api-gateway:8000
# HTTP server timeouts and graceful-shutdown budget (Go time.ParseDuration format)
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=30s

# Alert Service (TypeScript)
ALERT_PORT=8002
