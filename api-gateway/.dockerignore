# .dockerignore for api-gateway (Python / FastAPI)
# docker build に不要なファイルを除外してコンテキスト転送を削減する。
# .gitignore とは別ファイルで、docker build 時にのみ参照される。

# VCS / GitHub
.git
.gitignore
.gitattributes
.github

# 環境ファイル (イメージへ焼き付けないこと)
.env
.env.*
!.env.example

# Python キャッシュ / バイトコード
__pycache__
**/__pycache__
*.py[cod]
*$py.class

# 仮想環境 / パッケージング成果物
.venv
venv
.eggs
*.egg
*.egg-info
dist
build

# テスト / カバレッジ成果物
.pytest_cache
.coverage
.coverage.*
htmlcov
.tox
.mypy_cache
.ruff_cache

# IDE / エディタ
.vscode
.idea
*.swp
*.swo
*~

# OS メタデータ
.DS_Store
Thumbs.db

# ドキュメント / Docker 自身 (COPY 対象外)
README.md
Dockerfile
.dockerignore
